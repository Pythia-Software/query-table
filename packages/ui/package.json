{
  "name": "@pythia-software/query-table-ui",
  "version": "0.1.0",
  "description": "Schema-driven data table — opinionated, themeable React components.",
  "keywords": ["data-table", "query-builder", "react", "components", "typescript"],
  "license": "MIT",
  "author": "Pythia Software",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pythia-Software/query-table.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/Pythia-Software/query-table#readme",
  "bugs": { "url": "https://github.com/Pythia-Software/query-table/issues" },
  "engines": { "node": ">=22" },
  "type": "module",
  "sideEffects": ["**/*.css"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsup src/index.ts src/theme.css --format esm --dts --sourcemap --clean --target es2020 --external react --external react-dom --external @tanstack/react-virtual --external @pythia-software/query-table-core --external @pythia-software/query-table-react",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pythia-software/query-table-core": "0.1.0",
    "@pythia-software/query-table-react": "0.1.0",
    "@tanstack/react-virtual": "^3.14.11"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  }
}
