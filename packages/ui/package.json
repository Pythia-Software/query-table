  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@query-table/core": "0.0.0",
    "@query-table/react": "0.0.0"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
