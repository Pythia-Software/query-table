{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Pythia-Software/query-table/schema/query-wire.schema.json",
  "title": "query-table v3 query protocol",
  "description": "Every JSON value that crosses the v3 query wire: the capabilities handshake, QueryRequestV3 and QueryResultV3. This file is the source of truth; tools/wire-codegen generates the TypeScript, Go and Swift types from it. Property order is the Go struct (and so Go encoding) order. See docs/wire-protocol.md.",
  "$defs": {
    "FieldName": {
      "type": "string", "minLength": 1, "maxLength": 256,
      "description": "A field name (FieldDef.name, or @computed/<id>)."
    },
    "FilterOp": {
      "description": "Filter operators. Every value can be NULL, so is_null/is_not_null are valid for every field type.",
      "type": "string",
      "enum": ["=", "!=", ">", ">=", "<", "<=", "contains", "starts_with", "ends_with", "matches_regex", "not_matches_regex", "length_gt", "length_lt", "length_eq", "includes", "is_null", "is_not_null"]
    },
    "WhereClause": {
      "x-ts-name": "WireWhereClause", "x-go-type": "WhereClause",
      "description": "One predicate. `value` is the raw string the UI captured; executors coerce it by the field's declared type. Datetime comparisons also accept signed offsets such as \"-1h\" relative to `now`. `negated` is a null-exclusive NOT, set only for ops without a complement.",
      "type": "object", "additionalProperties": false, "required": ["field", "op", "value"],
      "properties": {
        "field": { "$ref": "#/$defs/FieldName" },
        "op": { "$ref": "#/$defs/FilterOp" },
        "value": { "type": "string", "maxLength": 10000, "x-swift-default": "\"\"" },
        "negated": { "type": "boolean" }
      }
    },
    "WhereConjunction": {
      "x-ts-name": "WireWhereConjunction", "x-go-type": "WhereClause",
      "description": "One branch of an OR group that ANDs several literals. Branches do not nest.",
      "type": "object", "additionalProperties": false, "required": ["all"],
      "properties": { "all": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/WhereClause" } } }
    },
    "WhereBranch": {
      "x-ts-name": "WireWhereBranch", "x-go-type": "WhereClause",
      "description": "One alternative of an OR group: a literal or a conjunction.",
      "oneOf": [
        { "$ref": "#/$defs/WhereClause", "x-swift-case": "literal" },
        { "$ref": "#/$defs/WhereConjunction", "x-swift-case": "all" }
      ]
    },
    "OrGroup": {
      "x-ts-name": "WireOrGroup", "x-go-type": "WhereTerm",
      "description": "A disjunction of literals or conjunctions: (a AND b) OR c.",
      "type": "object", "additionalProperties": false, "required": ["any"],
      "properties": { "any": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/WhereBranch" } } }
    },
    "WhereTerm": {
      "x-ts-name": "WireWhereTerm", "x-go-type": "WhereTerm", "x-swift-type": "WhereTerm",
      "description": "One conjunct of a WHERE: a literal or an OR group. A WHERE is the AND of its terms; every literal counts against the 100-predicate budget.",
      "oneOf": [{ "$ref": "#/$defs/WhereClause" }, { "$ref": "#/$defs/OrGroup" }]
    },
    "RegexExtract": {
      "x-swift-name": "RegexExtraction",
      "description": "Sort by the first capture group of a regex match (or the whole match); a non-match is NULL.",
      "type": "object", "additionalProperties": false, "required": ["regex"],
      "properties": { "regex": { "type": "string", "maxLength": 10000 } }
    },
    "OrderByClause": {
      "x-go-name": "OrderBy",
      "description": "One ORDER BY term; array order is sort priority.",
      "type": "object", "additionalProperties": false, "required": ["field", "dir"],
      "properties": {
        "field": { "$ref": "#/$defs/FieldName" },
        "dir": { "type": "string", "enum": ["asc", "desc"], "x-swift-default": "\"asc\"" },
        "nulls": { "type": "string", "enum": ["first", "last"], "description": "NULL placement; omitted is last." },
        "extract": { "$ref": "#/$defs/RegexExtract" }
      }
    },
    "AggOp": {
      "description": "A single aggregate operation; only count needs no measure field.",
      "type": "string", "enum": ["count", "count_distinct", "sum", "avg", "min", "max"]
    },
    "MetricScope": { "type": "string", "enum": ["allMatching", "shownRows"] },
    "MetricDateGrouping": {
      "x-ts-name": "WireMetricDateGrouping",
      "description": "Calendar grouping of the first group key. Calendar intervals key a bucket by its start instant; hourOfDay (0-23) and dayOfWeek (ISO 1-7) key a slot by number. Whole intervals and occurrences are planned by the client into plain calendar metrics and never cross the wire.",
      "type": "object", "additionalProperties": false, "required": ["field", "interval", "includeEmpty", "range"],
      "properties": {
        "field": { "$ref": "#/$defs/FieldName" },
        "interval": { "type": "string", "enum": ["hour", "day", "week", "month", "year", "hourOfDay", "dayOfWeek"] },
        "timeZone": { "type": "string", "maxLength": 80, "description": "IANA identifier; omitted is UTC." },
        "includeEmpty": { "type": "boolean", "description": "Add a bucket for every interval of the range." },
        "range": { "type": "string", "enum": ["query", "observed", "custom"] },
        "start": { "type": "string" },
        "end": { "type": "string" }
      }
    },
    "MetricDisplayHint": {
      "description": "The only display state on the wire: scatter pairs `expression` with `expressionY`.",
      "type": "object", "additionalProperties": false, "required": ["kind"],
      "properties": { "kind": { "type": "string", "enum": ["scatter"] } }
    },
    "MetricSort": {
      "x-ts-name": "WireMetricSort",
      "type": "object", "additionalProperties": false, "required": ["key", "dir"],
      "properties": {
        "key": { "type": "string", "pattern": "^(value|y|count|samples|group[0-9]+)$", "x-ts-type": "\"value\" | \"y\" | \"count\" | \"samples\" | `group${number}`" },
        "dir": { "type": "string", "enum": ["asc", "desc"] },
        "nulls": { "type": "string", "enum": ["first", "last"] }
      }
    },
    "MetricDistribution": {
      "description": "A box or histogram over `input` per group instead of a scalar value.",
      "type": "object", "additionalProperties": false, "required": ["kind", "input"],
      "properties": {
        "kind": { "type": "string", "enum": ["box", "histogram"] },
        "input": { "type": "string" },
        "whiskers": { "type": "string", "enum": ["minmax", "tukey"] },
        "bins": { "type": "integer", "minimum": 1 }
      }
    },
    "MetricMinCountDistinct": {
      "type": "object", "additionalProperties": false, "required": ["min", "distinct"],
      "properties": { "min": { "type": "integer", "minimum": 1, "maximum": 1000000 }, "distinct": { "$ref": "#/$defs/FieldName" } }
    },
    "MetricMinCountSum": {
      "type": "object", "additionalProperties": false, "required": ["min", "sum"],
      "properties": { "min": { "type": "integer", "minimum": 1, "maximum": 1000000 }, "sum": { "$ref": "#/$defs/FieldName" } }
    },
    "MetricMinCount": {
      "x-go-type": "MetricMinCount",
      "description": "Drop small groups before sorting, groupLimit and Other: a number counts rows; an object counts a field's distinct non-null values or sums a numeric field. Removed groups are reported as hiddenGroups.",
      "oneOf": [
        { "type": "integer", "minimum": 1, "maximum": 1000000, "x-swift-case": "rows" },
        { "$ref": "#/$defs/MetricMinCountDistinct", "x-swift-case": "distinct" },
        { "$ref": "#/$defs/MetricMinCountSum", "x-swift-case": "sum" }
      ]
    },
    "MetricSpec": {
      "x-ts-name": "MetricSpecV3", "x-go-name": "AggSpec", "x-swift-name": "MetricSpecV3",
      "description": "One metric as sent: an AggregationClause without its presentation (label, layout, display other than scatter, window, share).",
      "type": "object", "additionalProperties": false, "required": ["id", "op", "groupBy"],
      "properties": {
        "dateGrouping": { "$ref": "#/$defs/MetricDateGrouping" },
        "diagnostics": { "type": "array", "items": { "type": "string" } },
        "display": { "$ref": "#/$defs/MetricDisplayHint" },
        "expression": { "type": "string", "description": "A formula over aggregates; replaces op/field." },
        "expressionY": { "type": "string", "description": "The scatter y expression." },
        "scope": { "$ref": "#/$defs/MetricScope" },
        "sort": { "type": "array", "items": { "$ref": "#/$defs/MetricSort" } },
        "groupLimit": { "type": "integer", "minimum": 0 },
        "distribution": { "$ref": "#/$defs/MetricDistribution" },
        "id": { "type": "string", "minLength": 1, "maxLength": 256, "description": "Echoed by the result entry." },
        "op": { "$ref": "#/$defs/AggOp" },
        "field": { "$ref": "#/$defs/FieldName", "description": "Measure field; omitted only for count." },
        "groupBy": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/FieldName" }, "x-swift-default": "[]" },
        "where": { "type": "array", "items": { "$ref": "#/$defs/WhereTerm" }, "description": "The metric's own predicate, ANDed with the table WHERE.", "x-swift-name": "whereTerms" },
        "minCount": { "$ref": "#/$defs/MetricMinCount", "x-go-omit": "omitzero" }
      }
    },
    "CalendarGroupKey": {
      "description": "A grouping key that buckets a datetime field by calendar interval, keyed by the interval's start instant. Weeks start on Monday.",
      "type": "object", "additionalProperties": false, "required": ["field", "interval"],
      "properties": {
        "field": { "$ref": "#/$defs/FieldName" },
        "interval": { "type": "string", "enum": ["hour", "day", "week", "month", "year"] },
        "timeZone": { "type": "string", "maxLength": 80, "description": "IANA identifier; omitted is UTC." }
      }
    },
    "GroupKey": {
      "description": "A field name (group by exact value) or a calendar key.",
      "oneOf": [
        { "$ref": "#/$defs/FieldName", "x-swift-case": "field" },
        { "$ref": "#/$defs/CalendarGroupKey", "x-swift-case": "calendar" }
      ]
    },
    "SummaryColumn": {
      "x-ts-name": "WireSummaryColumn",
      "description": "One summary column of a grouping stage. Display and link columns are client-only.",
      "type": "object", "additionalProperties": false, "required": ["id", "op"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "op": { "type": "string", "enum": ["count", "count_distinct", "sum", "avg", "min", "max", "row", "formula"] },
        "field": { "$ref": "#/$defs/FieldName" },
        "expression": { "type": "string" },
        "label": { "type": "string" }
      }
    },
    "RepresentativeRow": {
      "x-ts-name": "WireRepresentativeRow",
      "description": "The ordering that picks each group's representative row for ROW summaries.",
      "type": "object", "additionalProperties": false, "required": ["orderBy"],
      "properties": { "orderBy": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/OrderByClause" } } }
    },
    "GroupingDefinition": {
      "x-ts-name": "WireGroupingDefinition", "x-go-type": "GroupingDefinition",
      "description": "One grouping stage over the complete source population; the result stage's where is HAVING.",
      "type": "object", "additionalProperties": false, "required": ["keys", "summaries", "representative"],
      "properties": {
        "keys": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/GroupKey" } },
        "summaries": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/SummaryColumn" } },
        "representative": { "oneOf": [{ "$ref": "#/$defs/RepresentativeRow" }, { "type": "null" }] },
        "diagnostics": { "type": "array", "items": { "type": "string" } }
      }
    },
    "HostQueryState": {
      "description": "Query state a host owns and registers with useQueryTable({ hostQuery }), such as a keyword clause it runs itself. It travels with the table query through saves, links, history and resets. params are named lists of strings, like URL search parameters, sorted by name; the host interprets them. Query Table passes it through uninterpreted. Version 0 marks a payload that could not be read and is always rejected on restore.",
      "type": "object", "additionalProperties": false, "required": ["version", "params"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "params": {
          "type": "object", "maxProperties": 64, "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,127}$" },
          "additionalProperties": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 4000 } }
        }
      }
    },
    "DistinctRequestV3": {
      "description": "Distinct values of one server-filterable field: a literal, case-insensitive substring match on the value as text (empty matches all), ordered by count desc then value asc. textarray fields contribute each element.",
      "type": "object", "additionalProperties": false, "required": ["field", "search", "limit"],
      "properties": {
        "field": { "$ref": "#/$defs/FieldName" },
        "search": { "type": "string", "maxLength": 2000, "x-swift-default": "\"\"" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 500, "x-swift-default": "50" }
      }
    },
    "QueryCapabilitiesV3": {
      "description": "The server's query handshake.",
      "type": "object", "required": ["version", "groupedRows", "calendarGrouping", "computedSourceFilters", "regex", "maxRows", "maxGroups", "maxPopulation", "profile"],
      "x-swift-init": false,
      "properties": {
        "regexSourceFilters": { "type": "boolean", "x-go-omit": "none" },
        "regexAggregateExpressions": { "type": "boolean", "x-go-omit": "none" },
        "metricFilters": { "type": "boolean", "x-go-omit": "none", "description": "Executes MetricSpec.where." },
        "metricMinCount": { "type": "boolean", "x-go-omit": "none", "description": "Executes a numeric minCount and reports hiddenGroups." },
        "metricMinCountMeasures": { "type": "boolean", "x-go-omit": "none", "description": "Also executes an object minCount." },
        "version": { "const": 3 },
        "groupedRows": { "type": "boolean" },
        "calendarGrouping": { "type": "boolean" },
        "calendarCycles": { "type": "boolean", "x-go-omit": "none", "description": "Executes the hourOfDay and dayOfWeek intervals." },
        "calendarGroupKeys": { "type": "boolean", "x-go-omit": "none", "description": "Executes calendar grouping keys." },
        "computedSourceFilters": { "type": "boolean" },
        "regex": { "type": "boolean" },
        "maxRows": { "type": "integer" },
        "maxGroups": { "type": "integer" },
        "maxPopulation": { "type": "integer" },
        "profile": { "type": "string" }
      }
    },
    "QueryRequestV3": {
      "description": "One v3 query: rows, metrics, groups or distinct values. source.where runs before grouping; result selects, filters (HAVING) and pages. Servers refuse a request with diagnostics.",
      "type": "object", "additionalProperties": false, "x-swift-init": false,
      "required": ["version", "profile", "expectedRevisions", "now", "source", "result", "rows", "metrics", "diagnostics"],
      "properties": {
        "version": { "const": 3 },
        "profile": { "type": "string" },
        "now": { "type": "integer", "minimum": -8640000000000000, "maximum": 8640000000000000, "x-go-repr": "int64", "x-swift-repr": "Int64", "description": "Evaluation clock, epoch milliseconds." },
        "expectedRevisions": { "type": "object", "maxProperties": 64, "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 256 }, "description": "Computed definition id to the revision the client planned with." },
        "planToken": { "type": "string" },
        "snapshot": { "type": "string" },
        "source": { "$ref": "#/$defs/ServerQuery" },
        "result": { "$ref": "#/$defs/ServerQuery" },
        "grouping": { "$ref": "#/$defs/GroupingDefinition" },
        "rows": { "type": "boolean" },
        "metrics": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/MetricSpec" } },
        "distinct": { "$ref": "#/$defs/DistinctRequestV3", "description": "Filter-value suggestions over source.where; requires rows false, no metrics and no grouping." },
        "diagnostics": { "type": "array", "items": { "type": "string" } },
        "hostState": { "type": "object", "x-ts-type": "HostQueryState", "x-go-type": "json.RawMessage", "x-swift-type": "[String: JSONValue]", "description": "Host-owned state, passed through uninterpreted: any JSON object. Query Table's TypeScript client sends a HostQueryState ({ version, params }); a host defines what its own clients send." }
      }
    },
    "MetricValue": {
      "description": "A metric value or group key: a number for count/sum/avg, the column's value for min/max; null when undefined. Go carries it as any, Swift as JSONValue.",
      "oneOf": [{ "type": "number" }, { "type": "string" }, { "type": "boolean" }, { "type": "null" }]
    },
    "MetricBoxSummary": {
      "type": "object", "required": ["n", "min", "q1", "median", "q3", "max", "mean", "low", "high", "outliers", "outlierCount", "whiskers", "method"],
      "properties": {
        "n": { "type": "integer", "x-go-repr": "int64" },
        "min": { "type": "number" }, "q1": { "type": "number" }, "median": { "type": "number" }, "q3": { "type": "number" },
        "max": { "type": "number" }, "mean": { "type": "number" },
        "low": { "type": "number", "description": "Lower whisker." }, "high": { "type": "number", "description": "Upper whisker." },
        "outliers": { "type": "array", "items": { "type": "number" } },
        "outlierCount": { "type": "integer", "x-go-repr": "int64" },
        "whiskers": { "type": "string", "enum": ["minmax", "tukey"] },
        "method": { "type": "string", "enum": ["exact-linear"] }
      }
    },
    "MetricBoxDistribution": {
      "type": "object", "required": ["kind", "summary"],
      "properties": {
        "kind": { "const": "box" },
        "summary": { "oneOf": [{ "$ref": "#/$defs/MetricBoxSummary" }, { "type": "null" }], "x-go-repr": "*MetricBoxSummary", "description": "null when the group has no numeric samples." }
      }
    },
    "MetricHistogramDistribution": {
      "description": "Bin i is edges[i] <= value < edges[i+1]; the final bin includes its upper edge.",
      "type": "object", "required": ["kind", "edges", "counts", "n"],
      "properties": {
        "kind": { "const": "histogram" },
        "edges": { "type": "array", "items": { "type": "number" } },
        "counts": { "type": "array", "items": { "type": "integer" }, "x-go-repr": "[]int64" },
        "n": { "type": "integer", "x-go-repr": "int64" }
      }
    },
    "MetricDistributionResult": {
      "x-go-type": "MetricDistributionResult",
      "oneOf": [
        { "$ref": "#/$defs/MetricBoxDistribution", "x-swift-case": "box" },
        { "$ref": "#/$defs/MetricHistogramDistribution", "x-swift-case": "histogram" }
      ]
    },
    "MetricBucket": {
      "x-ts-name": "MetricBucketV3", "x-swift-name": "AggregationBucket", "x-swift-init": false,
      "x-go-extra": ["// A measured minCount's value for calendar filtering; never serialized.", "minMeasure any", "minMeasureError bool"],
      "description": "One group of a metric result. `keys` has one entry per groupBy field ([] for a grand total); a null key is the NULL bucket.",
      "type": "object", "required": ["keys", "value", "count"],
      "properties": {
        "distribution": { "$ref": "#/$defs/MetricDistributionResult" },
        "nullCount": { "type": "integer", "x-go-repr": "*int64", "description": "Distribution inputs that were NULL." },
        "inputErrorCount": { "type": "integer", "x-go-repr": "*int64", "description": "Distribution inputs that were errors." },
        "keys": { "type": "array", "items": { "$ref": "#/$defs/MetricValue" } },
        "value": { "$ref": "#/$defs/MetricValue", "x-swift-lenient": ".null", "description": "The metric: a number for count/sum/avg, a column value for min/max, null when undefined. Swift reads an omitted value as null, as before." },
        "count": { "type": "integer", "x-go-repr": "int64", "description": "COUNT(*) of rows in the group." },
        "error": { "type": "string" },
        "y": { "$ref": "#/$defs/MetricValue", "x-go-repr": "*any", "description": "The scatter y value." },
        "yError": { "type": "string" }
      }
    },
    "MetricResult": {
      "x-ts-name": "MetricResultV3", "x-swift-name": "AggregationResultEntry", "x-swift-init": false,
      "description": "One metric's result, in request order.",
      "type": "object", "required": ["id", "buckets"],
      "properties": {
        "id": { "type": "string" },
        "buckets": { "type": "array", "items": { "$ref": "#/$defs/MetricBucket" } },
        "scope": { "$ref": "#/$defs/MetricScope", "x-go-omit": "none" },
        "processedRows": { "type": "integer", "x-go-repr": "int64", "x-go-omit": "none" },
        "groupCount": { "type": "integer", "x-go-repr": "int64", "x-go-omit": "none", "description": "Groups before groupLimit, excluding hidden groups." },
        "coverage": { "type": "string", "enum": ["exact", "partial"] },
        "error": { "type": "string", "description": "The metric could not be computed; siblings are unaffected." },
        "hiddenGroups": { "type": "integer", "x-go-repr": "*int64", "description": "Groups removed by minCount; present whenever it is set." },
        "other": { "$ref": "#/$defs/MetricBucket", "x-go-repr": "*MetricBucket", "description": "The exact omitted additive quantity beyond groupLimit, when an executor computes it." }
      }
    },
    "FieldType": { "type": "string", "enum": ["text", "number", "enum", "datetime", "bool", "textarray"] },
    "ComputedFieldCapability": {
      "x-ts-name": "ComputedFieldCapabilities", "x-swift-name": "ComputedFieldCapabilityV3", "x-swift-init": false,
      "description": "What a canonical computed field may do in a view. Hints for client planning, never authorization.",
      "type": "object", "required": ["type", "select", "sort", "measure", "group"],
      "properties": {
        "filter": { "type": "boolean", "description": "Host-approved canonical predicates; omitted is closed." },
        "type": { "$ref": "#/$defs/FieldType" },
        "select": { "type": "boolean" },
        "sort": { "type": "boolean" },
        "measure": { "type": "boolean" },
        "group": { "type": "boolean" },
        "reason": { "type": "string" }
      }
    },
    "ComputedExecution": {
      "x-swift-name": "QueryExecutionV3", "x-swift-init": false,
      "description": "The execution envelope: profile, token, snapshot, resolved computed revisions and capabilities. A fingerprint is not authorization.",
      "type": "object", "required": ["profile", "planToken", "resolvedRevisions", "fields"],
      "properties": {
        "profile": { "type": "string" },
        "planToken": { "type": "string", "x-swift-lenient": "\"\"", "description": "Empty without a handshake. Swift reads an omitted token as empty, as before." },
        "resolvedRevisions": { "type": "object", "additionalProperties": { "type": "string" } },
        "fields": { "type": "object", "additionalProperties": { "$ref": "#/$defs/ComputedFieldCapability" } },
        "fingerprint": { "type": "string" },
        "snapshot": { "type": "string" }
      }
    },
    "ProjectedField": {
      "x-ts-name": "ProjectedFieldV3", "x-swift-name": "ProjectedFieldV3",
      "type": "object", "required": ["name", "type"],
      "properties": { "name": { "type": "string" }, "type": { "type": "string" } }
    },
    "ProjectedSchema": {
      "x-ts-name": "ProjectedSchemaV3", "x-swift-name": "ProjectedSchemaV3",
      "description": "The result's schema: grouped results use the group identity field.",
      "type": "object", "required": ["name", "idField", "fields"],
      "properties": {
        "name": { "type": "string" },
        "idField": { "type": "string" },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/ProjectedField" } }
      }
    },
    "DistinctResultV3": {
      "type": "object", "required": ["values", "hasMore", "hasNull"],
      "properties": {
        "values": { "type": "array", "items": { "type": "string" }, "description": "Non-NULL matches as text, at most limit." },
        "hasMore": { "type": "boolean", "x-swift-default": "false" },
        "hasNull": { "type": "boolean", "x-swift-default": "false", "description": "The population has a NULL (textarray: NULL or empty), whatever the search." }
      }
    },
    "QueryResultV3": {
      "x-swift-init": false,
      "description": "The answer to one QueryRequestV3. Row cells are JSON scalars, arrays (textarray) or {\"computedError\": code}.",
